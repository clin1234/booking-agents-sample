# DocumentDB Connection
# Use host.docker.internal when running in Codespaces/DevContainer
# Use localhost when running directly on your machine
DOCUMENTDB_CONNECTION_STRING=mongodb://admin:password123@localhost:10260/?tls=true&tlsAllowInvalidCertificates=true&authMechanism=SCRAM-SHA-256

# OpenAI Configuration
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-3.5-turbo

# Database Configuration
COLLECTION_NAME=listings
DATABASE_NAME=db